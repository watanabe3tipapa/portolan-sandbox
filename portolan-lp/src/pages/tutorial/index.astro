---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const tutorials = (await getCollection('tutorial')).sort((a, b) => a.data.order - b.data.order);
const heroTitle = 'チュートリアル';
const heroLead = 'Portolan を「作って・公開するところまで」学べる入門シリーズです。';
const colors = ['mint', 'pink', 'lemon', 'sky'];
---

<Layout>
	<main>
		<section class="hero">
			<h1>{heroTitle}</h1>
			<p class="lead">{heroLead}</p>
		</section>

		<section class="list">
			{
				tutorials.map((t, i) => (
					<a
						href={`${import.meta.env.BASE_URL}tutorial/${t.id}/`}
						class={`card ${colors[i % colors.length]}`}>
						<h2>{t.data.title}</h2>
						<p>{t.data.description}</p>
					</a>
				))
			}
			<a href={`${import.meta.env.BASE_URL}`} class="button back">&larr; トップへ戻る</a>
		</section>
	</main>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 3rem 2rem;
		background: var(--nb-pink);
		border-bottom: var(--nb-border);
	}

	.hero h1 {
		font-size: 2.8rem;
		margin: 0 0 0.5rem;
		display: inline-block;
		padding: 0.25em 0.75em;
		background: var(--nb-bg);
		border: var(--nb-border);
		box-shadow: var(--nb-shadow);
	}

	.lead {
		font-weight: 700;
		max-width: 640px;
		margin: 0 auto;
	}

	.list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 3rem auto;
		padding: 0 2rem;
	}

	.card {
		display: block;
		text-decoration: none;
		border: var(--nb-border);
		box-shadow: var(--nb-shadow);
		padding: 1.5rem;
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease;
	}

	.card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 6px 6px 0 var(--nb-ink);
	}

	.card.mint {
		background: var(--nb-mint);
	}
	.card.pink {
		background: var(--nb-pink);
	}
	.card.lemon {
		background: var(--nb-lemon);
	}
	.card.sky {
		background: var(--nb-sky);
	}

	.card h2 {
		color: var(--nb-ink);
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
	}

	.card p {
		font-size: 0.95rem;
		line-height: 1.7;
		margin: 0;
		color: var(--nb-fg-light);
	}

	.back {
		grid-column: 1 / -1;
		text-align: center;
		margin: 1rem auto 0;
		justify-self: center;
	}

	.button {
		display: inline-block;
		background: var(--nb-ink);
		color: var(--nb-bg);
		padding: 0.7rem 1.4rem;
		font-weight: 900;
		text-decoration: none;
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease;
	}

	.button:hover {
		transform: translate(-2px, -2px);
		box-shadow: 2px 2px 0 var(--nb-ink);
	}
</style>
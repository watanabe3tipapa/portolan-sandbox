---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const features = (await getCollection('feature')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const heroTitle = '特集';
const heroLead = 'Google Maps / OpenStreetMap とのデータ連携や、共通プロトコルの用例、実証デモの解説をお届けします。';
const colors = ['pink', 'sky', 'mint', 'lemon', 'pink'];
---

<Layout>
	<main>
		<section class="hero">
			<h1>{heroTitle}</h1>
			<p class="lead">{heroLead}</p>
		</section>

		<section class="list">
			{
				features.map((f, i) => (
					<a
						href={`${import.meta.env.BASE_URL}feature/${f.id}/`}
						class={`card ${colors[i % colors.length]}`}>
						<h2>{f.data.title}</h2>
						<p>{f.data.description}</p>
						<time>{f.data.pubDate.toISOString().slice(0, 10)}</time>
					</a>
				))
			}
			<a href={`${import.meta.env.BASE_URL}`} class="button back">&larr; トップへ戻る</a>
		</section>
	</main>
</Layout>

<style>
	.hero {
		text-align: center;
		padding: 3rem 2rem;
		background: var(--nb-sky);
		border-bottom: var(--nb-border);
	}

	.hero h1 {
		font-size: 2.8rem;
		margin: 0 0 0.5rem;
		display: inline-block;
		padding: 0.25em 0.75em;
		background: var(--nb-bg);
		border: var(--nb-border);
		box-shadow: var(--nb-shadow);
	}

	.lead {
		font-weight: 700;
		max-width: 640px;
		margin: 0 auto;
	}

	.list {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1.5rem;
		max-width: 1000px;
		margin: 3rem auto;
		padding: 0 2rem;
	}

	.card {
		display: block;
		text-decoration: none;
		border: var(--nb-border);
		box-shadow: var(--nb-shadow);
		padding: 1.5rem;
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease;
	}

	.card:hover {
		transform: translate(-2px, -2px);
		box-shadow: 6px 6px 0 var(--nb-ink);
	}

	.card.mint {
		background: var(--nb-mint);
	}
	.card.pink {
		background: var(--nb-pink);
	}
	.card.sky {
		background: var(--nb-sky);
	}
	.card.lemon {
		background: var(--nb-lemon);
	}

	.card h2 {
		color: var(--nb-ink);
		font-size: 1.15rem;
		margin-bottom: 0.5rem;
	}

	.card p {
		font-size: 0.95rem;
		line-height: 1.7;
		margin: 0 0 0.75rem;
		color: var(--nb-fg-light);
	}

	time {
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--nb-fg-light);
		opacity: 0.7;
	}

	.back {
		grid-column: 1 / -1;
		text-align: center;
		margin: 1rem auto 0;
		justify-self: center;
	}

	.button {
		display: inline-block;
		background: var(--nb-ink);
		color: var(--nb-bg);
		padding: 0.7rem 1.4rem;
		font-weight: 900;
		text-decoration: none;
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease;
	}

	.button:hover {
		transform: translate(-2px, -2px);
		box-shadow: 2px 2px 0 var(--nb-ink);
	}
</style>
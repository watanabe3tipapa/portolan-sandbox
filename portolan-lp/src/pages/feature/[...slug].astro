---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const features = await getCollection('feature');
	return features.map((entry) => ({
		params: { slug: entry.id },
		props: { entry },
	}));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const features = (await getCollection('feature')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const currentIndex = features.findIndex((f) => f.id === entry.id);
const prev = features[currentIndex + 1];
const next = features[currentIndex - 1];
---

<Layout>
	<main class="article">
		<nav class="breadcrumb">
			<a href={`${import.meta.env.BASE_URL}`} class="crumb">ホーム</a>
			<span>/</span>
			<a href={`${import.meta.env.BASE_URL}feature/`} class="crumb">特集</a>
		</nav>

		<article>
			<header>
				<h1>{entry.data.title}</h1>
				<p class="description">{entry.data.description}</p>
				<p class="date">{entry.data.pubDate.toISOString().slice(0, 10)}</p>
			</header>

			<div class="content">
				<Content />
			</div>
		</article>

		<nav class="pager">
			{next && <a href={`${import.meta.env.BASE_URL}feature/${next.id}/`} class="crumb prev">&larr; {next.data.title}</a>}
			{prev && <a href={`${import.meta.env.BASE_URL}feature/${prev.id}/`} class="crumb next">{prev.data.title} &rarr;</a>}
		</nav>
	</main>
</Layout>

<style>
	.article {
		max-width: 760px;
		margin: 0 auto;
		padding: 3rem 2rem;
	}

	.breadcrumb {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		margin-bottom: 2rem;
		font-weight: 700;
	}

	.crumb {
		display: inline-block;
		padding: 0.25rem 0.7rem;
		background: var(--nb-bg);
		border: var(--nb-border);
		box-shadow: 2px 2px 0 var(--nb-ink);
		text-decoration: none;
		font-weight: 700;
		transition:
			transform 0.1s ease,
			box-shadow 0.1s ease;
	}

	.crumb:hover {
		transform: translate(-1px, -1px);
		box-shadow: 3px 3px 0 var(--nb-ink);
	}

	.breadcrumb span {
		color: var(--nb-fg-light);
		font-weight: 400;
	}

	header {
		margin-bottom: 3rem;
	}

	h1 {
		font-size: 2.2rem;
		line-height: 1.4;
		margin-bottom: 0.5rem;
		padding-bottom: 0.5rem;
		border-bottom: var(--nb-border);
	}

	.description {
		color: var(--nb-fg-light);
		margin: 0 0 0.5rem;
	}

	.date {
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--nb-fg-light);
		opacity: 0.7;
		margin: 0;
	}

	.content :global(h2) {
		font-size: 1.4rem;
		font-weight: 900;
		margin-top: 3rem;
		margin-bottom: 0.8rem;
		padding: 0.4rem 0.8rem;
		background: var(--nb-mint);
		border-left: 4px solid var(--nb-ink);
	}

	.content :global(h3) {
		font-size: 1.15rem;
		font-weight: 900;
		margin-top: 2rem;
		padding-bottom: 0.3rem;
		border-bottom: var(--nb-border);
	}

	.content :global(pre) {
		background: #2d2a3e;
		color: #e0dcf0;
		padding: 1.2rem;
		border: var(--nb-border);
		box-shadow: var(--nb-shadow);
		overflow-x: auto;
		font-size: 0.9rem;
		line-height: 1.6;
		margin: 1.2rem 0;
	}

	.content :global(code) {
		font-family: "SFMono-Regular", Consolas, monospace;
	}

	.content :global(p code) {
		background: var(--nb-lavender);
		padding: 0.15rem 0.4rem;
		font-weight: 700;
		font-size: 0.9em;
	}

	.content :global(blockquote) {
		border: var(--nb-border);
		background: var(--nb-lemon);
		box-shadow: 2px 2px 0 var(--nb-ink);
		padding: 0.8rem 1.2rem;
		margin: 1.5rem 0;
	}

	.content :global(blockquote p) {
		margin: 0;
	}

	.content :global(table) {
		width: 100%;
		border-collapse: collapse;
		margin: 1.5rem 0;
		border: var(--nb-border);
		box-shadow: 2px 2px 0 var(--nb-ink);
	}

	.content :global(th),
	.content :global(td) {
		border: var(--nb-border);
		padding: 0.5rem 0.8rem;
		text-align: left;
		font-size: 0.95rem;
	}

	.content :global(th) {
		background: var(--nb-sky);
		font-weight: 900;
	}

	.content :global(td) {
		background: var(--nb-bg);
	}

	.content :global(a) {
		color: var(--nb-ink);
		font-weight: 700;
		text-decoration: underline;
		text-decoration-thickness: 2px;
		text-underline-offset: 3px;
	}

	.content :global(a:hover) {
		background: var(--nb-lemon);
	}

	.pager {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: var(--nb-border);
	}

	.pager .crumb {
		font-weight: 700;
		max-width: 48%;
		text-align: left;
	}

	.next {
		margin-left: auto;
		text-align: right !important;
	}
</style>